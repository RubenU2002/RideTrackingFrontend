{
  "expo": {
    "name": "RideTrackingFrontend",
    "slug": "RideTrackingFrontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["ridetrackingfrontend", "com.anonymous.RideTrackingFrontend"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación durante la carrera para registrar el viaje.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Seguimos registrando tu ubicación en segundo plano mientras la carrera está activa.",
        "UIBackgroundModes": ["location", "location"]
      },
      "bundleIdentifier": "com.anonymous.RideTrackingFrontend"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE"
      ],
      "foregroundService": {
        "type": "location",
        "exported": false
      },
      "package": "com.anonymous.RideTrackingFrontend"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      ["@rnmapbox/maps", {}]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
